<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mcp_audit_log_view_list" model="ir.ui.view">
        <field name="name">mcp.audit.log.list</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="status == 'error'" decoration-warning="status == 'denied'">
                <field name="create_date" string="Time"/>
                <field name="user_id"/>
                <field name="client_name"/>
                <field name="tool"/>
                <field name="model"/>
                <field name="res_ids" optional="show"/>
                <field name="preview" optional="show"/>
                <field name="status"/>
                <field name="message" optional="show"/>
                <field name="duration_ms" optional="hide"/>
                <field name="ip" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mcp_audit_log_view_form" model="ir.ui.view">
        <field name="name">mcp.audit.log.form</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Time"/>
                            <field name="user_id"/>
                            <field name="client_name"/>
                            <field name="auth"/>
                            <field name="grant_id"/>
                            <field name="ip"/>
                        </group>
                        <group>
                            <field name="tool"/>
                            <field name="model"/>
                            <field name="res_ids"/>
                            <field name="preview"/>
                            <field name="status"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Arguments"><field name="arguments" nolabel="1" colspan="2"/></group>
                    <group string="Message"><field name="message" nolabel="1" colspan="2"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_audit_log_view_search" model="ir.ui.view">
        <field name="name">mcp.audit.log.search</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="tool"/>
                <field name="model"/>
                <field name="user_id"/>
                <field name="client_name"/>
                <filter name="writes" string="Writes"
                        domain="[('tool', 'in', ('create_record', 'update_record', 'archive_record', 'delete_record', 'run_action', 'set_image_from_url', 'post_note', 'propose_rule'))]"/>
                <filter name="denied" string="Denied" domain="[('status', '=', 'denied')]"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_tool" string="Tool" context="{'group_by': 'tool'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_audit_log" model="ir.actions.act_window">
        <field name="name">MCP Audit</field>
        <field name="res_model">mcp.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
