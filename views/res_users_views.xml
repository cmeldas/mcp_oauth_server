<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_mcp" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mcp</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='api_keys']" position="after">
                <div name="mcp_grants" class="d-lg-flex mt-3">
                    <div class="col-lg-3 d-flex flex-column">
                        <label for="mcp_grant_ids" string="AI Clients (MCP)" class="o_form_label"/>
                        <span class="text-muted">
                            Claude and other connections via MCP. For Claude Code without OAuth, create an API key with an MCP scope above.
                        </span>
                    </div>
                    <div class="w-lg-75 d-flex flex-column my-auto">
                        <field name="mcp_grant_ids" readonly="1" invisible="not mcp_grant_ids">
                            <list create="0" delete="0">
                                <field name="client_name"/>
                                <field name="write_allowed" string="Write"/>
                                <field name="create_date" string="Connected"/>
                                <field name="last_used"/>
                                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban" class="text-danger"/>
                            </list>
                        </field>
                        <span class="text-muted" invisible="mcp_grant_ids">No AI client is connected.</span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_mcp_yolo" model="ir.ui.view">
        <field name="name">res.users.form.mcp.yolo</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="MCP" name="mcp" invisible="share" groups="base.group_system">
                    <field name="mcp_yolo" widget="boolean_toggle"/>
                </group>
                <div class="alert alert-danger" role="alert" invisible="not mcp_yolo" groups="base.group_system">
                    <strong>YOLO:</strong> AI clients of this user can do everything the user can do in Odoo,
                    administration included, without write rules. Use it only on a test database.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
